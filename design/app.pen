              "name": "spacingText",
              "fill": "#6C6C6C",
              "content": "Layout is desktop-only and rigid by design: 52px app header, 24px main padding, 16-24px column gaps, dashboard in two panels, workspace in 280px sidebar plus one dominant editor column.",
