{
  "name": "sms-formats-client",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "bunx ultracite check",
    "format": "bunx ultracite fix",
    "lint:fix": "bun run format",
    "bot:dev": "bun run --env-file=bot/.env bot/server.ts",
    "bot:build": "bun build bot/server.ts --compile --target=bun-linux-x64 --outfile=dist-bot/sms-formats-bot",
    "bot:roundtrip": "bash ./scripts/bot-roundtrip-local.sh",
    "check:secrets": "bash ./scripts/check-secrets.sh",
    "verify": "bun run typecheck && bun run test && bun run check:secrets && bun run lint",
    "prepare:publish": "bun run verify"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.1.18",
    "ultracite": "7.1.5",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.14",
    "@fontsource-variable/geist": "^5.2.8",
    "@octokit/rest": "^22.0.1",
    "@tanstack/react-query": "^5.90.21",
    "@the-node-forge/regex-simplifier": "^1.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "grammy": "^1.43.0",
    "i18next": "^25.8.5",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.577.0",
    "mutative": "^1.3.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.13.0",
    "shadcn": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "travels": "^1.1.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  }
}
