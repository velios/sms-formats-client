{
  "name": "sms-formats-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bot:build": "bun build bot/server.ts --compile --target=bun-linux-x64 --outfile=dist-bot/sms-formats-bot",
    "bot:dev": "bun run --env-file=bot/.env bot/server.ts",
    "bot:roundtrip": "bash ./scripts/bot-roundtrip-local.sh",
    "prebuild": "bun run content:build",
    "build": "vite build",
    "check:secrets": "bash ./scripts/check-secrets.sh",
    "content:build": "bun run scripts/build-content.ts",
    "predev": "bun run content:build",
    "dev": "vite",
    "format": "bunx ultracite fix",
    "lint": "bunx ultracite check",
    "lint:fix": "bun run format",
    "prepare:publish": "bun run verify",
    "preview": "vite preview",
    "pretest": "bun run content:build",
    "test": "bun test --isolate",
    "test:watch": "bun test --isolate --watch",
    "pretypecheck": "bun run content:build",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run test && bun run check:secrets && bun run lint"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/geist": "^5.3.0",
    "@octokit/rest": "^22.0.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "grammy": "^1.46.0",
    "i18next": "^26.4.2",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.49.0",
    "mutative": "^1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "travels": "^2.2.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "7.12.2",
    "vite": "^8.3.1"
  }
}
