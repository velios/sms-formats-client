# Replace placeholders:
#   sms-formats.example.com
#   /var/www/sms-formats-client/current

sms-formats.example.com {
    root * /var/www/sms-formats-client/current
    encode zstd gzip

    @assets path /assets/*
    handle @assets {
        file_server
    }

    handle {
        try_files {path} /index.html
        file_server
    }
}
