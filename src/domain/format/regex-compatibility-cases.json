      "match": "AUTORIZAȚI PLATA",
      "groups": []
    }
  },
  {
    "id": "backreference",
    "pattern": "(?i)^(код)\\s+\\1$",
    "sms": "КОД код",
    "upstream": {
      "match": "КОД код",
      "groups": ["КОД"]
    }
  },
  {
    "id": "optional-nested-groups",
