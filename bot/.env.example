# Recognition Bot — server-side secrets (separate bun app; see docs/adr/0002).
# Copy to bot/.env and fill in. .env is gitignored — never commit real values.
# These are NOT VITE_ vars: they must never reach the frontend client bundle.

RECOGNITION_BOT_TOKEN=
RECOGNITION_BOT_WEBHOOK_SECRET=
RECOGNITION_BOT_WEBHOOK_PATH=
GITHUB_READONLY_TOKEN=

# Local port for the long-lived webhook process (Caddy reverse-proxies to it).
# Neutral non-privileged port, kept below the ephemeral range (32768+).
RECOGNITION_BOT_PORT=8470

# Optional HTTP proxy for outbound Telegram API calls. Leave empty for direct
# egress; set it where api.telegram.org is blocked and a local bridge is used.
RECOGNITION_BOT_PROXY_URL=
