# Recognition Bot — server-side secrets (separate bun app; see docs/adr/0002).
# Copy to bot/.env and fill in. .env is gitignored — never commit real values.
# These are NOT VITE_ vars: they must never reach the frontend client bundle.

RECOGNITION_BOT_TOKEN=
RECOGNITION_BOT_WEBHOOK_SECRET=
RECOGNITION_BOT_WEBHOOK_PATH=

# No GitHub token is needed: the source repo (RECOGNITION_BOT_SOURCE_REPO) is
# public, so the corpus clone and the open-PR REST call both work anonymously.
# A GITHUB_READONLY_TOKEN would only raise the REST rate limit (60→5000/h) — the
# bot makes ~1 call per boot, so it isn't worth maintaining an expiring secret.
# A revoked token here once crash-looped the bot (401 on boot); keep it out.

# Local port for the long-lived webhook process (Caddy reverse-proxies to it).
# Neutral non-privileged port, kept below the ephemeral range (32768+).
RECOGNITION_BOT_PORT=8470

# Optional HTTP proxy for outbound Telegram API calls. Leave empty for direct
# egress; set it where api.telegram.org is blocked and a local bridge is used.
RECOGNITION_BOT_PROXY_URL=

# The bot host's own domain. Used ONLY as {$RECOGNITION_BOT_DOMAIN} in
# docs/caddy/sms-formats-bot.caddy (the host's reverse proxy). Telegram cannot
# reach this domain — never register the webhook against it (ADR-0005). Kept out
# of the repo so the host stays private.
RECOGNITION_BOT_DOMAIN=

# The public relay domain Telegram actually reaches, distinct from
# RECOGNITION_BOT_DOMAIN above. scripts/bot-set-webhook.sh registers the webhook
# against THIS domain. Registering against the bot host's own (Telegram-blocked)
# domain yields silent "Connection timed out" deliveries — the trap ADR-0005
# calls "самая коварная ошибка". No fallback: the script errors if unset.
RECOGNITION_BOT_WEBHOOK_DOMAIN=

# Corpus source: repo and branch cloned on first boot, then read from disk on
# restart (no re-clone). Defaults shown; override only for testing/forks.
RECOGNITION_BOT_SOURCE_REPO=zenmoney/sms-formats
RECOGNITION_BOT_SOURCE_BRANCH=main
# Local checkout dir (gitignored via .cache). Pre-seed it with a git checkout to
# skip cloning — e.g. the offline round-trip harness points here.
RECOGNITION_BOT_CHECKOUT_DIR=.cache/sms-formats-main

# Corpus freshness window (ms). A request older than this triggers one background
# check (two conditional ETag GETs); inside it, answers come from memory. The
# corpus changes on the order of hours, so 30–60s keeps staleness imperceptible
# while spending ~nothing against the REST limit (ADR-0004). Default 45000.
RECOGNITION_BOT_FRESHNESS_TTL_MS=45000
