# Server secrets; copy to bot/.env (gitignored).
RECOGNITION_BOT_TOKEN=
RECOGNITION_BOT_WEBHOOK_SECRET=
RECOGNITION_BOT_WEBHOOK_PATH=

RECOGNITION_BOT_PORT=8470
# Optional outbound Telegram proxy.
RECOGNITION_BOT_PROXY_URL=
# Public relay domain used by scripts/bot-set-webhook.sh; see ADR-0005.
RECOGNITION_BOT_WEBHOOK_DOMAIN=

# Public corpus repository; no GitHub token required.
RECOGNITION_BOT_SOURCE_REPO=zenmoney/sms-formats
RECOGNITION_BOT_SOURCE_BRANCH=main
RECOGNITION_BOT_CHECKOUT_DIR=.cache/sms-formats-main
RECOGNITION_BOT_FRESHNESS_TTL_MS=45000

# Local verification only: dry-run prevents Telegram sends, offline skips GitHub.
RECOGNITION_BOT_DRY_RUN=0
RECOGNITION_BOT_OFFLINE=0
