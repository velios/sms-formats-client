[Unit]
Description=SMS Formats Recognition Bot (Telegram webhook)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ bot_service_user_resolved }}
EnvironmentFile={{ bot_deploy_dir_resolved }}/.env
# Persistent, service-owned dir for the main checkout. Created by systemd as
# /var/lib/sms-formats-bot and survives restarts, so the corpus is cloned once
# on first boot and read from disk afterwards (ADR-0004). Overrides any relative
# default from .env, which would resolve against a non-writable CWD under systemd.
StateDirectory=sms-formats-bot
Environment=RECOGNITION_BOT_CHECKOUT_DIR=%S/sms-formats-bot/main-checkout
ExecStart={{ bot_deploy_dir_resolved }}/sms-formats-bot
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
